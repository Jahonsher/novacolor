{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "VITE_BASE=/ VITE_API=1 npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://fact-increasing-push-missouri.trycloudflare.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://fact-increasing-push-missouri.trycloudflare.com/uploads/:path*" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ]
}
