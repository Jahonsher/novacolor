{
  "name": "novacolor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && cp dist/index.html dist/404.html && gh-pages -d dist --nojekyll",
    "build:site": "node server/scripts/build-site.mjs",
    "build:all": "npm run build:site && npm run server:build",
    "server:dev": "tsx watch --clear-screen=false server/src/index.ts",
    "server:build": "node -e \"require('fs').rmSync('server-dist',{recursive:true,force:true})\" && tsc -p server/tsconfig.json",
    "start": "node server-dist/index.js",
    "test:server": "node --import tsx --test \"server/test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22"
  }
}
